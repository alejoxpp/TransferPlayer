# Database
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_NAME=transferplayer

# Neon API (para branch management via GitHub Actions)
NEON_API_KEY=napi_xxxxxxxxxxxxxxxxxxxxxxxx

# Football API (API-Football via RapidAPI)
FOOTBALL_API_KEY=your_rapidapi_key_here
FOOTBALL_API_HOST=v3.football.api-sports.io

# App
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Optional: Supabase Auth (future)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=xxx