# Database (local dev - replace with your Neon URL)
NEON_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transferplayer
DB_NAME=transferplayer

# Neon API (optional)
NEON_API_KEY=

# Football API (API-Football via RapidAPI)
FOOTBALL_API_KEY=
FOOTBALL_API_HOST=v3.football.api-sports.io

# App
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true